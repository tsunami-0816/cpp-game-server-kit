# .env.example 模板（cpp-game-server-kit 纯 C++ 后端）
# ============================================
# 使用说明：
# 1. 复制为 .env，填入实际值
# 2. 所有配置项必须和代码里的配置一一对应
# 3. 敏感信息（密码/密钥）不要提交到 git
# 注：本项目无前端、不使用 JWT；登录态由 Redis session token 承载。
# ============================================

# 项目元信息
PROJECT_NAME=cpp-game-server-kit
PROJECT_PORT=8001

# 数据库 MySQL（WSL 开发库 root 空密码；生产必须改密码）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cpp_game
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis（避让 Windows 本机占用的 6379，WSL 内用 6380）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# 后端服务端口
ECHO_PORT=8000
GATEWAY_PORT=8001
BATTLE_PORT=8002
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
